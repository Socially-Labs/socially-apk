# Public identifiers copied into Expo config by app.config.ts.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Backend origin only, without /v0. Android emulator can use http://10.0.2.2:3000.
# For a USB-connected Android phone with http://127.0.0.1:3000, run:
# adb reverse tcp:3000 tcp:3000
# Otherwise use a reachable HTTPS API origin. Rebuild the APK after changing it.
EXPO_PUBLIC_API_URL=

# Optional development-only UI preview. Leave false for real authentication.
EXPO_PUBLIC_AUTH_PREVIEW=false

# In the Privy Dashboard, enable email login and allow com.socially.trade
# in the mobile app client. app.config.ts also accepts existing PRIVY_APP_ID
# and PRIVY_CLIENT_ID names. Enable Google, Apple and Twitter for social login,
# and allow apk:// with the /sign-in redirect path in the mobile app client.
# Expo Go also requires host.exp.exponent (Android) or host.exp.Exponent (iOS)
# in that client's allowed app identifiers; these values are case-sensitive.
# Apple currently uses browser OAuth on iOS, matching Android and web.

# Optional overrides for the default socially.trade/terms and /privacy links.
# Both must be HTTPS URLs to show the consent footer.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Signed-in support requests are saved through /v0/me/support-requests.
# Optional Settings links and email fallback. Support defaults to support@socially.trade.
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_URL=
