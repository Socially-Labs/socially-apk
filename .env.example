# Public identifiers copied into Expo config by app.config.ts.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Server-side only. Never expose this with an EXPO_PUBLIC_ prefix or Expo extra.
PRIVY_APP_SECRET=

# In the Privy Dashboard, enable email login and allow com.socially.trade
# in the mobile app client. app.config.ts also accepts existing PRIVY_APP_ID
# and PRIVY_CLIENT_ID names. Enable Google, Apple and Twitter for social login,
# and allow apk:// with the /sign-in redirect path in the mobile app client.
# Apple currently uses browser OAuth on iOS, matching Android and web.

# Optional overrides for the default socially.trade/terms and /privacy links.
# Both must be HTTPS URLs to show the consent footer.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Optional Settings overrides. Support defaults to support@socially.trade.
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_URL=
