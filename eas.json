{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "extends": "production",
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      }
    },
    "production": {
      "environment": "production",
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
